# ---------------------------------------------------------------------------
# Supabase — Project Settings → API Keys
# ---------------------------------------------------------------------------
# Supabase renombró sus claves. En proyectos creados desde 2025 vas a ver
# "Publishable key" y "Secret key"; en proyectos viejos, "anon public" y
# "service_role". El proyecto acepta las dos nomenclaturas: usá la que te
# muestre tu panel y dejá la otra vacía.

# URL del proyecto (Project Settings → API → Project URL)
# Ejemplo: https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública. Se expone al navegador: es segura porque TODAS las tablas
# tienen RLS activo. Empieza con sb_publishable_ en proyectos nuevos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Alternativa para proyectos anteriores. Si completaste la de arriba, dejala vacía.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta. NUNCA se expone al navegador y NUNCA lleva NEXT_PUBLIC_.
# Ignora por completo RLS. Se usa solo para crear el primer administrador y
# para las tareas de mantenimiento (expirar reservas sin seña, recordatorios).
# Empieza con sb_secret_ en proyectos nuevos.
SUPABASE_SECRET_KEY=

# Alternativa para proyectos anteriores. Si completaste la de arriba, dejala vacía.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------

# URL pública del sitio, sin barra final. Se usa en los links de confirmación
# de email de Supabase Auth y en los metadatos.
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto compartido para invocar /api/cron/mantenimiento. El cron lo envía en
# el header Authorization: Bearer <valor>. Generalo con: openssl rand -base64 32
CRON_SECRET=
